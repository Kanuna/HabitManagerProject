<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:HabitManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="HabitManager.LoginUserView"
			 x:DataType="vm:LoginUserViewModel"
			 Background="Gray"
			 Width="400" Height="800">

	<Grid ColumnDefinitions="*, 2*, *" RowDefinitions="*,2*,*">

		<Border IsVisible="{Binding ShowError}}" BorderBrush="Black" BorderThickness="2" Padding="5" Grid.Column="1"
				HorizontalAlignment="Center" VerticalAlignment="Bottom">

			<TextBlock Name="ErrorMessage" Text="{Binding ErrorMessage, Mode=TwoWay}"
					   Foreground="Black" FontSize="18" FontWeight="Bold"
					   TextWrapping="Wrap" TextAlignment="Center"/>
		</Border>
		
		<StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Spacing="3">

			<TextBlock Text="Email:" FontWeight="Bold" FontSize="14"/>
			<TextBox Text="{Binding Email}" Watermark="Enter email"/>

			<TextBlock Text="Password:" FontWeight="Bold" FontSize="14"/>
			<TextBox Text="{Binding Password}" PasswordChar="*" Watermark="Enter password"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30" >
				<Button Content="Create" FontSize="20" Background="Black" Foreground="White"
						HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="CreateButton_Click"/>
				
				<Button Content="Login" FontSize="20" Background="Green" Foreground="White"
						HorizontalAlignment="Right" VerticalAlignment="Bottom"
						IsEnabled="{Binding CanLogin}" Click="LoginButton_Click"/>

			</StackPanel>
		</StackPanel>
		
		
	</Grid>
</UserControl>
